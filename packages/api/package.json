{
	"name": "@self-feed/api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --env-file=../../.env.example --env-file=.env --watch src/index.ts",
		"dev:worker": "bun --env-file=../../.env.example --env-file=.env --watch src/worker.ts",
		"start": "bun --env-file=../../.env.example --env-file=.env src/index.ts",
		"start:worker": "bun --env-file=../../.env.example --env-file=.env src/worker.ts",
		"start:feed-relay": "bun src/feed-relay.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run tests/unit",
		"test:unit": "vitest run tests/unit",
		"test:integration": "bun test tests/integration",
		"build": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun --env-file=.env src/db/migrate.ts",
		"db:push": "drizzle-kit push",
		"db:seed": "bun --env-file=.env src/db/seed.ts",
		"openapi:generate": "bun src/openapi/generate.ts"
	},
	"dependencies": {
		"@self-feed/shared": "workspace:*",
		"dompurify": "^3.5.0",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.22",
		"ioredis": "^6.1.0",
		"jose": "^6.2.18",
		"jsdom": "^31.0.1",
		"prom-client": "^15.1.3",
		"rss-parser": "^3.13.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/bun": "^1.4.5",
		"@types/dompurify": "^3.2.0",
		"@types/jsdom": "^30.0.0",
		"drizzle-kit": "^0.31.11",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	}
}
