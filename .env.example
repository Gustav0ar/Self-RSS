# Development environment example only.
# Production must use real infrastructure credentials and unique random secrets.
NODE_ENV=development

# SQLite
DATABASE_URL=data/rss.db

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=dev-only-change-me-before-production-32chars
JWT_REFRESH_SECRET=dev-only-change-me-refresh-before-production-32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_SESSION_ABSOLUTE_TTL_DAYS=400
AUTH_SESSION_IDLE_TTL_DAYS=30
AUTH_SESSION_CLEANUP_BATCH_SIZE=250

# API
API_PORT=3000
API_HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false
TRUSTED_PROXY_HOPS=0
REQUIRE_WORKER_HEARTBEAT=false

# Web
VITE_API_URL=http://localhost:3000

# Admin
# ADMIN_EMAIL=admin@local.test
# ADMIN_PASSWORD=dev-only-admin-password

# Feed sync
FEED_SYNC_CONCURRENCY=5
# Local/source deployments stay on the reversible legacy path unless explicitly activated.
# The production Docker Compose file defaults both API and worker to v2 together.
FEED_PIPELINE_MODE=legacy
FEED_SYNC_TIMEOUT_MS=30000
FEED_MAX_CONTENT_LENGTH=5242880
FEED_ALLOW_PRIVATE_HOSTS=false
# Durable operational history is cleaned hourly in bounded transactions.
FEED_INGESTION_HISTORY_RETENTION_DAYS=14
FEED_INGESTION_CLEANUP_BATCH_SIZE=250
# Optional authenticated, SSRF-safe relay used only after direct 401/403/429 responses
FEED_FETCH_RELAY_URL=
FEED_FETCH_RELAY_TOKEN=
# Deprecated compatibility setting; generic relay targets no longer require a static host list.
FEED_FETCH_RELAY_HOSTS=

# Worker cache warming
CACHE_WARMER_INTERVAL_MS=60000
CACHE_WARMER_RECENT_WINDOW_MINUTES=10
CACHE_WARMER_RECENT_USERS_LIMIT=25
CACHE_WARMER_CONCURRENCY=5
CACHE_WARMER_IDLE_USERS_ENABLED=false
CACHE_WARMER_IDLE_USERS_LIMIT=25

# Article retention is opt-in and dry-run by default
RETENTION_DELETION_ENABLED=false
RETENTION_DELETION_DAYS=90
RETENTION_DRY_RUN=true

# Rate Limiting
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_FEED_CREATE_MAX=100
RATE_LIMIT_SEARCH_MAX=100
